# ====================================================
# AI Bid Generator 环境变量模板
# 复制为 .env 并按需修改：
#   cp .env.example .env
# 生成密钥：openssl rand -base64 32
# ====================================================

# ---- Django 核心 ----
# 密钥：生产环境必须改成随机字符串
DJANGO_SECRET_KEY=dev-insecure-change-me
# Fernet 密钥（加密存储 API Key 等），生产必须配置：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY_ENCRYPTION=
# 轮换 Fernet 密钥时临时存放旧密钥（仅用于解密存量密文），重加密完成后删除
# SECRET_KEY_ENCRYPTION_PREVIOUS=
# 允许的 host，逗号分隔；生产环境应改成你的域名
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL ----
# Docker 部署时使用 docker-compose.yml 中的服务名 postgres
# 本地开发时改成 localhost
DATABASE_URL=postgres://bid:bid@localhost:5432/bid
# 容器内数据库口令（compose 锚点使用；改密码需同时 ALTER ROLE）
POSTGRES_USER=bid
POSTGRES_PASSWORD=bid
POSTGRES_DB=bid

# ---- Redis ----
# Docker 部署时使用服务名 redis
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- MinIO 对象存储 ----
# root 管理员凭据（务必改成强随机值；仅用于运维，应用不使用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 内部 endpoint（容器间用服务名 minio:9000）
MINIO_ENDPOINT=minio:9000
# 浏览器可达地址：本机开发用 localhost:9000；远程部署必须改成外网 host:port
# 否则预签名 URL 浏览器访问 localhost 会失败
MINIO_PUBLIC_ENDPOINT=localhost:9000
# 是否通过 nginx 代理 MinIO；true 时预签名 URL 使用 /minio/ 路径
MINIO_PROXY_ENABLED=true
# 应用专用低权账号（仅限 bid-files bucket，不要用 root 凭据）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bid-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES_SECONDS=3600

# ---- ONLYOFFICE Document Server ----
# JWT 密钥：生产环境必须改成随机字符串
ONLYOFFICE_JWT_SECRET=change-this-to-a-long-random-secret
# ONLYOFFICE 服务地址（容器间互调用）
ONLYOFFICE_DOCUMENT_SERVER_URL=http://onlyoffice-document-server
# 浏览器可达地址
ONLYOFFICE_PUBLIC_BASE_URL=http://localhost:8082

# ---- AI 模型 Provider（可选，按需配置） ----
# 示例：DeepSeek / OpenAI / 通义千问 等
# 在前端「系统设置 → AI 模型配置」中添加 Provider，API key 通过界面填写
# 也可通过环境变量注入：
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# DASHSCOPE_API_KEY=sk-xxx
