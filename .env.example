DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://bid:bid@localhost:5432/bid
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
MINIO_ENDPOINT=minio:9000
# 浏览器可达的 MinIO 地址；远程部署必须改成外网 host:port，否则预签名 URL 浏览器访问 localhost 会失败
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bid-files
MINIO_SECURE=false
MINIO_PRESIGN_EXPIRES_SECONDS=3600
