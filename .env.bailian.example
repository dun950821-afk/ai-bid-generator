# 阿里云百炼知识库配置

# 阿里云 AccessKey ID
# 从阿里云控制台获取：https://ram.console.aliyun.com/manage/ak
BAILIAN_ACCESS_KEY_ID=your_access_key_id_here

# 阿里云 AccessKey Secret
# 注意：这是敏感信息，请勿泄露
BAILIAN_ACCESS_KEY_SECRET=your_access_key_secret_here

# 百炼工作空间ID
# 从百炼控制台获取：https://bailian.console.aliyun.com/
BAILIAN_WORKSPACE_ID=your_workspace_id_here

# 百炼服务端点（可选，默认值已内置）
# 默认值：bailian.cn-beijing.aliyuncs.com
# 可选值：
#   - bailian.cn-beijing.aliyuncs.com (华北2-北京)
#   - bailian.cn-shanghai.aliyuncs.com (华东2-上海)
#   - bailian.cn-hangzhou.aliyuncs.com (华东1-杭州)
#   - bailian.cn-shenzhen.aliyuncs.com (华南1-深圳)
BAILIAN_ENDPOINT=bailian.cn-beijing.aliyuncs.com

# 百炼区域ID（可选，默认值已内置）
# 默认值：cn-beijing
BAILIAN_REGION_ID=cn-beijing
